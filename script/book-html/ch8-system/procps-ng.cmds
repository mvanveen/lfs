# source: https://www.linuxfromscratch.org/lfs/view/stable/chapter08/procps-ng.html

./configure --prefix=/usr                           \
            --docdir=/usr/share/doc/procps-ng-4.0.5 \
            --disable-static                        \
            --disable-kill                          \
            --enable-watch8bit

make

chown -R tester .
su tester -c "PATH=$PATH make check"

make install

